{
  "name": "aip-design-system",
  "version": "1.1.0",
  "description": "AIP(Application Intent Protocol) 디자인 시스템 — DTCG 토큰, CSS 변수, 컴포넌트 CSS·JS, prose.css, Tailwind 프리셋, Mermaid 테마, 문서",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node tokens/build.mjs",
    "palette": "node tokens/scripts/palette-from-anchors.mjs > tokens/src/palette.json && node tokens/build.mjs",
    "brand": "python3 assets/brand/build-brand-assets.py",
    "test": "node tokens/build.mjs && node --test ../scripts/aip-design-system.test.mjs && npm run test:brand",
    "test:brand": "node --test ../scripts/brand-assets.test.mjs",
    "check:ui": "node ../scripts/aip-interaction.check.mjs"
  },
  "exports": {
    ".": "./dist/tokens.js",
    "./tokens.css": "./dist/tokens.css",
    "./typography.css": "./dist/typography.css",
    "./prose.css": "./dist/prose.css",
    "./components.css": "./dist/components.css",
    "./aip.js": "./dist/aip.js",
    "./tailwind": "./dist/tailwind.preset.cjs",
    "./mermaid": "./dist/diagram.mermaid.json",
    "./tokens.json": "./tokens/tokens.json",
    "./brand/*": "./assets/brand/*"
  },
  "files": ["dist", "tokens/tokens.json", "tokens/tokens.dark.json", "assets/brand"],
  "engines": { "node": ">=18" }
}
