{
  "name": "merrivoo-design-system",
  "version": "0.1.0",
  "description": "Merrivoo(메리부) 디자인 시스템 — DTCG 토큰, 세계관 테마, 컴포넌트 CSS, Scene·Tree·Ornament 조립 엔진, React 바인딩, 에셋 가공 도구",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node tokens/build.mjs",
    "palette": "node tokens/scripts/palette-from-anchors.mjs > tokens/src/palette.json && node tokens/build.mjs",
    "test": "node tokens/build.mjs && node --test ../scripts/merrivoo-design-system.test.mjs ../scripts/merrivoo-engine.test.mjs",
    "check:ui": "node ../scripts/merrivoo-interaction.check.mjs"
  },
  "exports": {
    ".": "./dist/tokens.js",
    "./tokens.css": "./dist/tokens.css",
    "./typography.css": "./dist/typography.css",
    "./components.css": "./dist/components.css",
    "./engine": "./engine/index.mjs",
    "./react": "./react/index.js",
    "./config": "./dist/design-system.config.json",
    "./tailwind": "./dist/tailwind.preset.cjs",
    "./tokens.json": "./tokens/tokens.json",
    "./schema/*": "./schema/*",
    "./assets/demo/*": "./assets/demo/*"
  },
  "files": ["dist", "engine", "react", "schema", "tools", "assets/demo", "tokens/tokens.json", "tokens/tokens.dark.json", "registry"],
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "engines": { "node": ">=18" }
}
