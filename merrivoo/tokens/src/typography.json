{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Pretendard Variable",
          "Pretendard",
          "-apple-system",
          "BlinkMacSystemFont",
          "system-ui",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "sans-serif"
        ],
        "$description": "질문·본문·버튼·입력. 읽기 쉬운 것이 우선. 라이선스 OFL 1.1(확인 필요: docs/02 §1 검증 표)."
      },
      "display": {
        "$value": [
          "Cormorant Garamond",
          "MaruBuri",
          "Nanum Myeongjo",
          "serif"
        ],
        "$description": "타이틀·세계관 이름·점수. 라틴·숫자는 Cormorant, 한글은 MaruBuri 로 글리프 단위 폴백. 한 줄 짧은 글에만."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400,
        "$description": "본문"
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600,
        "$description": "질문·제목·라벨"
      },
      "bold": {
        "$value": 700,
        "$description": "display·점수"
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "1rem=16px. 12px 아래 금지(모바일 하한). 입력 필드는 16px 미만 금지(iOS 확대 방지).",
      "xs": {
        "$value": "0.75rem",
        "$description": "12px"
      },
      "sm": {
        "$value": "0.875rem",
        "$description": "14px"
      },
      "md": {
        "$value": "1rem",
        "$description": "16px"
      },
      "lg": {
        "$value": "1.125rem",
        "$description": "18px"
      },
      "xl": {
        "$value": "1.25rem",
        "$description": "20px"
      },
      "2xl": {
        "$value": "1.5rem",
        "$description": "24px"
      },
      "3xl": {
        "$value": "1.75rem",
        "$description": "28px"
      },
      "4xl": {
        "$value": "2.125rem",
        "$description": "34px"
      },
      "5xl": {
        "$value": "2.625rem",
        "$description": "42px"
      },
      "6xl": {
        "$value": "3.5rem",
        "$description": "56px"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.15,
        "$description": "display·점수"
      },
      "snug": {
        "$value": 1.3,
        "$description": "제목"
      },
      "normal": {
        "$value": 1.5,
        "$description": "라벨·버튼"
      },
      "relaxed": {
        "$value": 1.6,
        "$description": "본문(한글 기준)"
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tighter": {
        "$value": "-0.02em",
        "$description": "display"
      },
      "tight": {
        "$value": "-0.01em",
        "$description": "제목·질문"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.08em",
        "$description": "overline"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "화면은 이 이름으로만 글자를 놓는다.",
    "display-lg": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.5xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": "{font.letter-spacing.tighter}"
      },
      "$description": "랜딩 타이틀. 모바일 한 줄 10자 이내. max 2줄"
    },
    "display-md": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.4xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": "{font.letter-spacing.tighter}"
      },
      "$description": "세계관 이름·결과 제목. max 2줄"
    },
    "display-sm": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": "{font.letter-spacing.tight}"
      },
      "$description": "카드·포스터 보조 제목. max 2줄"
    },
    "score": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.6xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.tight}",
        "letterSpacing": "{font.letter-spacing.tighter}"
      },
      "$description": "궁합 점수. 라이닝 숫자"
    },
    "heading-1": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      },
      "$description": "화면 제목. max 2줄"
    },
    "heading-2": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      },
      "$description": "시트·카드 제목"
    },
    "question": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      },
      "$description": "질문 문장. max 4줄, keep-all"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "결과 문구·세계관 설명. max 6줄"
    },
    "body-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "본문"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "보조 설명"
    },
    "label-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "주 버튼·선택지"
    },
    "label-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "보조 버튼·탭"
    },
    "label-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "칩·배지"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "도움말·메타"
    },
    "overline": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.wide}"
      },
      "$description": "섹션 위 짧은 라벨(영문 대문자만)"
    },
    "numeric": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.normal}"
      },
      "$description": "표·점수 옆 수치. tabular"
    }
  }
}
