{
  "name": "notting-design-system",
  "version": "1.2.0",
  "description": "notting 디자인 시스템 — DTCG 토큰, CSS 변수, prose.css, Tailwind 프리셋, 문서",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node tokens/build.mjs",
    "palette": "node tokens/scripts/palette-from-anchors.mjs > tokens/src/palette.json && node tokens/build.mjs",
    "brand": "python assets/brand/build-brand-assets.py",
    "test": "npm run test:brand && npm run test:experience",
    "test:brand": "node --test ../scripts/brand-assets.test.mjs",
    "test:experience": "node --test ../scripts/notting-experience-templates.test.mjs"
  },
  "exports": {
    ".": "./dist/tokens.js",
    "./tokens.css": "./dist/tokens.css",
    "./typography.css": "./dist/typography.css",
    "./prose.css": "./dist/prose.css",
    "./tailwind": "./dist/tailwind.preset.cjs",
    "./tokens.json": "./tokens/tokens.json",
    "./brand/*": "./assets/brand/*"
  },
  "files": ["dist", "tokens/tokens.json", "tokens/tokens.dark.json", "assets/brand"],
  "engines": { "node": ">=18" },
  "license": "MIT"
}
