{
  "shadow": {
    "$type": "shadow",
    "$description": "고도(elevation). 그림자 색은 ink(#0A0908) 계열이라 종이 위 따뜻한 그림자가 된다. 문서 화면은 그림자를 아낀다 — 카드는 테두리, 그림자는 떠 있는 것(메뉴·팔레트·모달)에만. 다크에서는 alpha 를 올린다(shadow-dark).",
    "xs": { "$value": [{ "color": "#0A09080D", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }], "$description": "세그먼트 활성 항목·버튼 살짝 입체감. 없어도 되는 단계" },
    "sm": { "$value": [
      { "color": "#0A09080F", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" },
      { "color": "#0A09080A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "-1px" }
    ], "$description": "hover 로 떠오르는 카드·이슈 카드 드래그 준비" },
    "md": { "$value": [
      { "color": "#0A090814", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" },
      { "color": "#0A09080A", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px" }
    ], "$description": "드롭다운·슬래시 메뉴·인라인 툴바·팝오버·스크롤 시 sticky 툴바" },
    "lg": { "$value": [
      { "color": "#0A09081A", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "-4px" },
      { "color": "#0A09080A", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-4px" }
    ], "$description": "모달·커맨드 팔레트·드로어·드래그 중인 블록/카드" },
    "xl": { "$value": [
      { "color": "#0A090824", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-8px" }
    ], "$description": "랜딩 히어로 목업. 앱 UI 금지" },
    "inner": { "$value": [{ "color": "#0A09081A", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "inset": true }], "$description": "눌린 상태·kbd 아래·인풋 안쪽" },
    "brand": { "$value": [{ "color": "#1EA8963D", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" }], "$description": "primary CTA hover 글로우. 랜딩에서만" },
    "ai":    { "$value": [{ "color": "#9395D340", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" }], "$description": "AI 패널 열릴 때·스트리밍 답변 카드 글로우. 앱에서 유일하게 허용되는 색 그림자" }
  },

  "shadow-dark": {
    "$type": "shadow",
    "$description": "다크 모드 그림자. 배경이 어두워 alpha 를 올리고, 대신 면 밝기 차이(surface.raised)가 고도의 주 신호가 된다.",
    "xs": { "$value": [{ "color": "#00000033", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "sm": { "$value": [{ "color": "#0000004D", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }] },
    "md": { "$value": [{ "color": "#00000066", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px" }] },
    "lg": { "$value": [{ "color": "#00000080", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-4px" }] },
    "xl": { "$value": [{ "color": "#00000099", "offsetX": "0px", "offsetY": "24px", "blur": "56px", "spread": "-8px" }] },
    "inner": { "$value": [{ "color": "#00000066", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "inset": true }] },
    "brand": { "$value": [{ "color": "#4EBBAA40", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" }] },
    "ai":    { "$value": [{ "color": "#9395D34D", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" }] }
  },

  "gradient": {
    "$type": "gradient",
    "$description": "그라데이션은 브랜드 표현 자리에서만: 랜딩 히어로, 온보딩, OG 이미지, 빈 상태 배경, AI 스트리밍 페이드. 버튼·인풋·표·문서 본문에는 쓰지 않는다. 각도는 135deg 하나(스크림·페이드만 180).",
    "brand": {
      "$value": [
        { "color": "{teal.800}",         "position": 0 },
        { "color": "{brand.verdigris}",  "position": 0.6 },
        { "color": "{brand.periwinkle}", "position": 1 }
      ],
      "$description": "주 그라데이션. 진한 verdigris → verdigris → periwinkle. 히어로·OG·로그인 사이드. 위 글자 white 는 어두운 시작점 쪽에만"
    },
    "context": {
      "$value": [
        { "color": "{brand.periwinkle}", "position": 0 },
        { "color": "{brand.verdigris}",  "position": 1 }
      ],
      "$description": "AI·Context Pack 표현. AI 배지 배경·강조 텍스트(background-clip: text)·Context Pack 카드 상단 바 3px. 위 글자 neutral.950"
    },
    "paper": {
      "$value": [
        { "color": "{brand.paper}", "position": 0 },
        { "color": "{teal.50}",     "position": 1 }
      ],
      "$description": "거의 안 보이는 배경. 랜딩 섹션·빈 상태 카드·온보딩. 위 글자 text.primary 그대로. 다크에서는 surface.brand-subtle 단색으로"
    },
    "ink": {
      "$value": [
        { "color": "{neutral.950}", "position": 0 },
        { "color": "{teal.950}",    "position": 1 }
      ],
      "$description": "어두운 브랜드 면. 다크 히어로·푸터·코드 중심 랜딩 섹션. 위 글자 white / teal.300"
    },
    "scrim-bottom": {
      "$value": [
        { "color": "#0A090800", "position": 0 },
        { "color": "#0A0908B3", "position": 1 }
      ],
      "$description": "커버 이미지 위 제목 가독용 하단 스크림. 180deg"
    },
    "fade-bottom": {
      "$value": [
        { "color": "#FFFFFF00", "position": 0 },
        { "color": "#FFFFFFFF", "position": 1 }
      ],
      "$description": "긴 답변·미리보기 카드 하단 '더 보기' 페이드. surface.default 색이라 다크에서는 surface 색으로 다시 그린다(component 에서 color-mix 권장). 180deg"
    }
  },

  "gradient-angle": {
    "$type": "number",
    "default": { "$value": 135, "$description": "deg. brand·context·paper·ink 공통" },
    "vertical": { "$value": 180, "$description": "scrim-bottom·fade-bottom" }
  },

  "opacity": {
    "$type": "number",
    "disabled":     { "$value": 0.4,  "$description": "비활성 요소 전체에 거는 값" },
    "hover":        { "$value": 0.06, "$description": "interactive.hover-overlay 의 alpha" },
    "pressed":      { "$value": 0.1 },
    "scrim":        { "$value": 0.5 },
    "skeleton":     { "$value": 0.6,  "$description": "스켈레톤 펄스 최저점" },
    "placeholder-image": { "$value": 0.08, "$description": "이미지 로딩 전 브랜드색 깔기" },
    "ghost-block":  { "$value": 0.5,  "$description": "드래그 중 원래 자리에 남는 블록·카드 잔상" },
    "stale":        { "$value": 0.7,  "$description": "'현재 아님' 근거·삭제된 문서 미리보기" }
  },

  "blur": {
    "$type": "dimension",
    "sm": { "$value": "4px",  "$description": "스크림 뒤 미세 블러" },
    "md": { "$value": "12px", "$description": "글래스 툴바(backdrop-filter) 스크롤 시" },
    "lg": { "$value": "24px", "$description": "모달·커맨드 팔레트 뒤 배경" }
  },

  "z-index": {
    "$type": "number",
    "$description": "레이어 순서. 컴포넌트 안에서 임의 z-index(999 등)를 쓰지 않는다. 같은 층 안 순서는 DOM 순서로 해결한다.",
    "hide":     { "$value": -1 },
    "base":     { "$value": 0 },
    "raised":   { "$value": 10,   "$description": "hover 카드·드래그 중 블록·인라인 툴바(에디터 안)" },
    "sidebar":  { "$value": 100,  "$description": "사이드바·우측 패널(드로어로 열릴 때는 overlay 위 modal 층)" },
    "dropdown": { "$value": 1000, "$description": "셀렉트·메뉴·슬래시 메뉴·멘션 목록" },
    "sticky":   { "$value": 1100, "$description": "페이지 툴바·표 헤더" },
    "overlay":  { "$value": 1200, "$description": "스크림" },
    "modal":    { "$value": 1300, "$description": "모달·커맨드 팔레트·드로어" },
    "popover":  { "$value": 1400, "$description": "모달 안에서 열리는 팝오버·날짜 선택" },
    "toast":    { "$value": 1500 },
    "tooltip":  { "$value": 1600 }
  }
}
