{
  "space": {
    "$type": "dimension",
    "$description": "4px 그리드. 이름은 4px 배수(space.4 = 16px). 기존 global.css 의 --space-16 같은 px 이름은 legacy-aliases.css 가 이어 준다. 정보 밀도가 높은 화면이라 base 보다 촘촘한 단계(6·10·14)를 유지한다.",
    "0":   { "$value": "0px" },
    "px":  { "$value": "1px" },
    "0-5": { "$value": "2px",   "$description": "세그먼트 트랙 안쪽, 아이콘 미세 조정" },
    "1":   { "$value": "4px",   "$description": "배지 내부, 등락 화살표↔숫자, 종목명↔시장 태그" },
    "1-5": { "$value": "6px",   "$description": "라벨↔인풋, 버튼 아이콘↔라벨" },
    "2":   { "$value": "8px",   "$description": "밀접한 요소 사이, 리스트 행 안 세로 간격" },
    "2-5": { "$value": "10px",  "$description": "리스트 행 상하 패딩(밀도 높음)" },
    "3":   { "$value": "12px",  "$description": "카드 안 요소 사이, 셀 좌우 패딩" },
    "3-5": { "$value": "14px" },
    "4":   { "$value": "16px",  "$description": "기본 단위. 컴포넌트 내부 패딩, 컴포넌트 사이, 모바일 좌우 여백 대안" },
    "5":   { "$value": "20px",  "$description": "카드 패딩 기본, 모바일 좌우 여백" },
    "6":   { "$value": "24px",  "$description": "카드 묶음 사이, 태블릿 좌우 여백, 페이지 섹션 gap" },
    "7":   { "$value": "28px" },
    "8":   { "$value": "32px",  "$description": "섹션 사이, 데스크톱 좌우 여백" },
    "10":  { "$value": "40px" },
    "12":  { "$value": "48px",  "$description": "섹션 사이(큰 구획)" },
    "16":  { "$value": "64px",  "$description": "온보딩·빈 화면 상하" }
  },

  "size": {
    "$type": "dimension",
    "control": {
      "$description": "기존 .btn 이 44 였다(터치 최소). sm 36, lg 52.",
      "xs": { "$value": "28px", "$description": "표 셀 안 아이콘 버튼·칩" },
      "sm": { "$value": "36px", "$description": "툴바·필터·세그먼트 항목·btn-sm" },
      "md": { "$value": "44px", "$description": "기본. 버튼·인풋. 터치 최소 44 를 그대로 만족" },
      "lg": { "$value": "52px", "$description": "하단 고정 CTA·로그인·btn-lg" },
      "xl": { "$value": "56px", "$description": "온보딩 CTA" }
    },
    "icon": {
      "xs": { "$value": "12px" }, "sm": { "$value": "16px" }, "md": { "$value": "20px" }, "lg": { "$value": "24px" }, "xl": { "$value": "32px" }, "2xl": { "$value": "48px" }
    },
    "avatar": {
      "$description": "종목 로고·사용자 아바타",
      "xs": { "$value": "24px" }, "sm": { "$value": "32px" }, "md": { "$value": "40px" }, "lg": { "$value": "56px" }, "xl": { "$value": "80px" }
    },
    "touch-target-min": { "$value": "44px" },
    "container": {
      "sm":  { "$value": "560px",  "$description": "로그인·계정·단일 폼" },
      "md":  { "$value": "768px",  "$description": "읽기 화면(뉴스·리서치 본문)" },
      "lg":  { "$value": "1024px", "$description": "종목 상세" },
      "xl":  { "$value": "1180px", "$description": "앱 기본 최대폭. 기존 --content-max. (finance-design-system.html 의 1080 은 낡은 값이라 1180 으로 통일)" },
      "2xl": { "$value": "1440px", "$description": "기술 차트 워크스페이스·와이드 표" },
      "prose": { "$value": "680px", "$description": "본문 글 한 줄 폭" }
    },
    "layout": {
      "header":           { "$value": "56px", "$description": "모바일 문맥 헤더" },
      "header-lg":        { "$value": "64px", "$description": "데스크톱 sticky 상단 탐색" },
      "subnav":           { "$value": "48px", "$description": "영역별 보조 탐색 줄" },
      "tabbar":           { "$value": "56px", "$description": "모바일 하단 5탭. safe-area-inset-bottom 을 더한다" },
      "sidebar":          { "$value": "240px" },
      "page-gutter":      { "$value": "20px", "$description": "모바일(375 기준). 기존 FDS 20" },
      "page-gutter-md":   { "$value": "24px", "$description": "태블릿 768 이상" },
      "page-gutter-lg":   { "$value": "32px", "$description": "데스크톱 1024 이상. 기존 --container-pad" },
      "grid-gap":         { "$value": "16px" },
      "grid-gap-md":      { "$value": "20px" },
      "grid-gap-lg":      { "$value": "24px" },
      "sticky-offset":    { "$value": "128px", "$description": "데스크톱 헤더 64 + 보조탐색 48 + 여유 16. sticky 패널 top 값" },
      "bottom-cta-pad":   { "$value": "16px", "$description": "하단 고정 CTA 패딩. + env(safe-area-inset-bottom)" }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "모바일 퍼스트. 375 는 가장 좁은 실기기 기준(가로 스크롤·잘림 0 이어야 한다), 768 이 모바일↔태블릿 전환점.",
    "xs":  { "$value": "375px" },
    "sm":  { "$value": "640px" },
    "md":  { "$value": "768px" },
    "lg":  { "$value": "1024px" },
    "xl":  { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "기존 FDS 8/12/16/20 유지 + 4·6 추가. 금융 앱은 base 보다 한 단계 더 둥글다(안전한 인상).",
    "none": { "$value": "0px" },
    "xs":   { "$value": "4px",  "$description": "체크박스·인라인 코드·미니 태그" },
    "sm":   { "$value": "6px",  "$description": "세그먼트 활성 항목·툴팁" },
    "md":   { "$value": "8px",  "$description": "sm 컨트롤·칩·작은 카드 안 요소" },
    "lg":   { "$value": "12px", "$description": "버튼·인풋·드롭다운. 기본" },
    "xl":   { "$value": "16px", "$description": "카드(밀도 높은)·리스트 컨테이너·바텀시트 항목" },
    "2xl":  { "$value": "20px", "$description": "카드 기본(기존 .card)·모달·바텀시트" },
    "3xl":  { "$value": "24px", "$description": "온보딩 히어로 카드" },
    "full": { "$value": "9999px" }
  },

  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "medium":   { "$value": "1.5px", "$description": "아웃라인 버튼(기존 btn-outline)" },
    "focus":    { "$value": "2px" },
    "accent":   { "$value": "3px", "$description": "선택된 탭 인디케이터·등락 좌측 바" }
  },

  "focus": {
    "ring-width":  { "$value": "2px", "$type": "dimension" },
    "ring-offset": { "$value": "2px", "$type": "dimension" },
    "ring-inset":  { "$value": "3px", "$type": "dimension", "$description": "인풋 안쪽 soft 링(focus-ring-soft)" }
  }
}
