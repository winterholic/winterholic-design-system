      "$description": "스프레드시트 뷰어(XLSX·CSV).",
      "cell-height":    { "$value": "{size.control.sm}", "$type": "dimension" },
      "cell-padding-x": { "$value": "{space.2}", "$type": "dimension" },
      "row-head-width": { "$value": "48px", "$type": "dimension" },
      "col-min-width":  { "$value": "96px", "$type": "dimension" },
      "col-max-width":  { "$value": "320px", "$type": "dimension" }
    },

    "code-block": {
      "bg":          { "$value": "{color.ink.bg}", "$type": "color" },
      "header-bg":   { "$value": "{color.ink.bg-header}", "$type": "color" },
      "border":      { "$value": "{color.ink.border}", "$type": "color" },
      "radius":      { "$value": "{radius.lg}", "$type": "dimension" },
      "padding-x":   { "$value": "{space.4}", "$type": "dimension" },
      "padding-y":   { "$value": "{space.3}", "$type": "dimension" },
      "header-height": { "$value": "{size.control.md}", "$type": "dimension" },
      "line-number-width": { "$value": "48px", "$type": "dimension" },
      "max-height":  { "$value": "480px", "$type": "dimension", "$description": "채팅 안 코드 블록. 넘으면 '모두 보기'. 코드 뷰어는 패널 높이를 따른다" }
    },

    "inline-code": {
      "bg":        { "$value": "{color.ink.bg-inline}", "$type": "color" },
      "text":      { "$value": "{color.ink.text-inline}", "$type": "color" },
      "padding-x": { "$value": "0.3em", "$type": "dimension", "$description": "글자 크기에 비례" },
      "radius":    { "$value": "{radius.xs}", "$type": "dimension" },
      "size":      { "$value": "0.875em", "$type": "dimension", "$description": "모노가 같은 크기 sans 보다 커 보여서 한 단계 줄인다" }
    },

    "prose": {
      "$description": "문서 본문(prose.css) 리듬. 에이전트 메시지 안 Markdown 과 Markdown 뷰어가 같은 규칙을 다른 밀도로 받는다.",
      "block-gap":  { "$value": "{space.5}", "$type": "dimension", "$description": "문서 뷰어 문단 사이" },
      "block-gap-compact": { "$value": "{space.3}", "$type": "dimension", "$description": "메시지 안 문단 사이" },
      "figure-gap": { "$value": "{space.6}", "$type": "dimension" },
      "h2-gap":     { "$value": "{space.10}", "$type": "dimension" },
      "h3-gap":     { "$value": "{space.8}", "$type": "dimension" },
      "h4-gap":     { "$value": "{space.6}", "$type": "dimension" },
      "heading-after": { "$value": "{space.3}", "$type": "dimension" },
      "list-indent":{ "$value": "{space.6}", "$type": "dimension" },
      "list-gap":   { "$value": "{space.1-5}", "$type": "dimension" }
    },

    "kbd": {
      "height":    { "$value": "20px", "$type": "dimension" },
      "padding-x": { "$value": "{space.1-5}", "$type": "dimension" },
      "radius":    { "$value": "{radius.xs}", "$type": "dimension" },
      "bg":        { "$value": "{color.surface.default}", "$type": "color" },
      "border":    { "$value": "{color.border.default}", "$type": "color" },
      "text":      { "$value": "{color.text.secondary}", "$type": "color" }
    },

    "split": {
      "handle":       { "$value": "{space.2}", "$type": "dimension", "$description": "분할 손잡이 히트 폭 8. 보이는 선은 hairline" },
      "handle-active":{ "$value": "{color.border.brand}", "$type": "color" }
    },

    "progress": {
      "height": { "$value": "4px", "$type": "dimension" },
      "track":  { "$value": "{color.surface.sunken}", "$type": "color" },
      "fill":   { "$value": "{color.action.primary.bg}", "$type": "color", "$description": "업로드·다운로드·변환 진행. 에이전트 실행 진행은 run.progress-fill(민트)" }
    },

    "meta-list": {
      "$description": "결과물 상세 메타데이터(dl). ID·형식·크기·해시·생성·보존·정책.",
      "term-width": { "$value": "112px", "$type": "dimension" },
      "row-gap":    { "$value": "{space.2}", "$type": "dimension" },
      "col-gap":    { "$value": "{space.4}", "$type": "dimension" }
    },

    "banner": {
      "$description": "헤더 아래 전폭 띠(오프라인·업데이트·설치 안내·재인증 필요).",
      "padding-x": { "$value": "{space.4}", "$type": "dimension" },
      "padding-y": { "$value": "{space.2}", "$type": "dimension" },
      "gap":       { "$value": "{space.2}", "$type": "dimension" }
    },

    "hit-area": {
      "$description": "시각 크기가 44 보다 작은 컨트롤의 터치 영역 확장(::after inset 음수).",
      "inset": { "$value": "-8px", "$type": "dimension", "$description": "32px 컨트롤 → 48px 영역" }
    }
  }
}
