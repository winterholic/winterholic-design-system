{
  "space": {
    "$type": "dimension",
    "$description": "간격. 4px 기반 스케일. 이름은 4px 배수(space.4 = 16px). 화면의 모든 margin·padding·gap 은 이 값 중 하나여야 한다 — 13px, 18px 같은 값이 나오면 잘못 잡은 것이다.",
    "0":   { "$value": "0px" },
    "px":  { "$value": "1px",   "$description": "테두리 겹침 보정·헤어라인 전용" },
    "0-5": { "$value": "2px",   "$description": "아이콘과 글자 사이 미세 조정" },
    "1":   { "$value": "4px",   "$description": "인라인 요소 사이(배지 내부, 아이콘·라벨)" },
    "1-5": { "$value": "6px" },
    "2":   { "$value": "8px",   "$description": "밀접한 요소 사이(라벨↔인풋, 버튼 그룹 내부)" },
    "3":   { "$value": "12px",  "$description": "컴포넌트 내부 패딩(sm 버튼 좌우, 리스트 아이템 상하)" },
    "4":   { "$value": "16px",  "$description": "기본 단위. 컴포넌트 내부 패딩(md), 폼 필드 사이, 카드 패딩(sm)" },
    "5":   { "$value": "20px",  "$description": "카드 패딩(md)" },
    "6":   { "$value": "24px",  "$description": "카드 패딩(lg), 관련 있는 블록 사이, 모달 패딩" },
    "8":   { "$value": "32px",  "$description": "섹션 내부 그룹 사이" },
    "10":  { "$value": "40px" },
    "12":  { "$value": "48px",  "$description": "섹션 사이(모바일)" },
    "16":  { "$value": "64px",  "$description": "섹션 사이(데스크톱)" },
    "20":  { "$value": "80px",  "$description": "히어로·랜딩 섹션 상하" },
    "24":  { "$value": "96px" },
    "32":  { "$value": "128px", "$description": "랜딩 대형 섹션 상하(데스크톱)" }
  },

  "size": {
    "$type": "dimension",
    "$description": "컴포넌트 고정 치수. 높이는 control, 아이콘은 icon, 아바타는 avatar 스케일을 따른다.",
    "control": {
      "$description": "버튼·인풋·셀렉트·탭 등 한 줄 컨트롤의 높이. 같은 줄에 놓이는 컨트롤은 반드시 같은 단계를 쓴다.",
      "xs": { "$value": "24px", "$description": "표 셀 안 아이콘 버튼, 칩 삭제 버튼" },
      "sm": { "$value": "32px", "$description": "밀도 높은 화면(툴바·표 필터·사이드바)" },
      "md": { "$value": "40px", "$description": "기본. 일반 폼·버튼" },
      "lg": { "$value": "48px", "$description": "모바일 주 액션·랜딩 CTA·로그인 폼. 터치 타깃 최소 44px 을 넘는다" },
      "xl": { "$value": "56px", "$description": "히어로 CTA 전용" }
    },
    "icon": {
      "xs": { "$value": "12px", "$description": "배지·캡션 옆" },
      "sm": { "$value": "16px", "$description": "sm 컨트롤 안, 본문 sm 옆" },
      "md": { "$value": "20px", "$description": "md 컨트롤 안, 본문 옆. 기본" },
      "lg": { "$value": "24px", "$description": "lg 컨트롤 안, 내비게이션, 헤더" },
      "xl": { "$value": "32px", "$description": "빈 상태·피처 아이콘" },
      "2xl": { "$value": "48px", "$description": "빈 상태 일러스트 대체·온보딩" }
    },
    "avatar": {
      "xs": { "$value": "24px" },
      "sm": { "$value": "32px" },
      "md": { "$value": "40px" },
      "lg": { "$value": "56px" },
      "xl": { "$value": "80px" },
      "2xl": { "$value": "128px", "$description": "프로필 페이지 헤더" }
    },
    "touch-target-min": { "$value": "44px", "$description": "터치 기기에서 클릭 영역 최소값. 시각 크기가 작아도 padding·pseudo-element 로 이만큼 확보한다" },
    "container": {
      "$description": "콘텐츠 최대 폭. 가운데 정렬 + 좌우 gutter(page-gutter) 를 함께 쓴다.",
      "sm":  { "$value": "640px",  "$description": "로그인·단일 폼·온보딩" },
      "md":  { "$value": "768px",  "$description": "읽기 위주 문서·설정 페이지" },
      "lg":  { "$value": "1024px", "$description": "일반 앱 콘텐츠" },
      "xl":  { "$value": "1280px", "$description": "대시보드·표 중심 화면. 기본 최대" },
      "2xl": { "$value": "1440px", "$description": "와이드 대시보드 전용" },
      "prose": { "$value": "720px", "$description": "본문 텍스트 한 줄 폭. 한국어 기준 한 줄 40~45자" }
    },
    "layout": {
      "header":       { "$value": "56px", "$description": "모바일 헤더 높이" },
      "header-lg":    { "$value": "64px", "$description": "데스크톱 헤더 높이" },
      "sidebar":      { "$value": "240px" },
      "sidebar-collapsed": { "$value": "64px" },
      "page-gutter":     { "$value": "16px", "$description": "모바일 화면 좌우 여백 = space.4" },
      "page-gutter-md":  { "$value": "24px", "$description": "태블릿 좌우 여백 = space.6" },
      "page-gutter-lg":  { "$value": "32px", "$description": "데스크톱 좌우 여백 = space.8" },
      "grid-gap":     { "$value": "16px", "$description": "모바일 그리드 컬럼 간격" },
      "grid-gap-lg":  { "$value": "24px", "$description": "데스크톱 그리드 컬럼 간격" }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "min-width 기준 모바일 퍼스트. Tailwind 기본과 같아 프리셋 교체 없이 그대로 쓴다.",
    "sm":  { "$value": "640px" },
    "md":  { "$value": "768px" },
    "lg":  { "$value": "1024px" },
    "xl":  { "$value": "1280px" },
    "2xl": { "$value": "1536px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "모서리. 크기가 큰 면일수록 큰 radius. 부모보다 자식이 더 둥글면 어색하다(부모 radius − 안쪽 padding ≈ 자식 radius).",
    "none": { "$value": "0px" },
    "xs":   { "$value": "4px",  "$description": "체크박스·작은 태그·코드 인라인" },
    "sm":   { "$value": "6px",  "$description": "xs·sm 컨트롤, 툴팁, 배지(사각형형)" },
    "md":   { "$value": "8px",  "$description": "md·lg 컨트롤(버튼·인풋), 드롭다운 메뉴. 기본" },
    "lg":   { "$value": "12px", "$description": "카드, 팝오버, 알림 배너" },
    "xl":   { "$value": "16px", "$description": "모달, 바텀시트, 대형 카드" },
    "2xl":  { "$value": "24px", "$description": "히어로 이미지·프로모션 카드" },
    "full": { "$value": "9999px", "$description": "필(pill) 버튼, 칩, 아바타, 토글, 도트" }
  },

  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "1px", "$description": "기본 테두리 전부" },
    "focus":    { "$value": "2px", "$description": "포커스 링, 선택 표시" },
    "accent":   { "$value": "4px", "$description": "왼쪽 강조 바(콜아웃·인용)" }
  },

  "focus": {
    "$description": "포커스 링 규격. 모든 포커스 가능한 요소에 동일 적용한다.",
    "ring-width":  { "$value": "2px", "$type": "dimension" },
    "ring-offset": { "$value": "2px", "$type": "dimension", "$description": "요소 외곽에서 띄우는 거리. 인풋처럼 안쪽으로 그릴 때는 0" }
  }
}
