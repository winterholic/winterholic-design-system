{
  "shadow": {
    "$type": "shadow",
    "$description": "고도(elevation). 그림자 색은 neutral.950 계열 남색 그림자를 써서 쿨 톤을 지킨다. 단계는 '얼마나 떠 있나'로 고른다. 다크에서는 alpha 를 두 배 가까이 올려야 보인다(shadow-dark 그룹).",
    "xs": { "$value": [{ "color": "#1B20270D", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }], "$description": "인풋·버튼 살짝 입체감. 없어도 되는 단계" },
    "sm": { "$value": [
      { "color": "#1B20270F", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" },
      { "color": "#1B20270A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "-1px" }
    ], "$description": "카드 기본(hover 전). 테두리 대신 쓸 수 있다" },
    "md": { "$value": [
      { "color": "#1B202714", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-2px" },
      { "color": "#1B20270A", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "-2px" }
    ], "$description": "카드 hover, 드롭다운, 팝오버, 스티키 헤더 스크롤 시" },
    "lg": { "$value": [
      { "color": "#1B20271A", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "-4px" },
      { "color": "#1B20270A", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "-4px" }
    ], "$description": "모달, 바텀시트, 드래그 중인 요소" },
    "xl": { "$value": [
      { "color": "#1B202724", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-8px" }
    ], "$description": "랜딩 히어로 목업 이미지·프로모션 카드. 앱 UI 에는 쓰지 않는다" },
    "inner": { "$value": [{ "color": "#1B20271A", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "inset": true }], "$description": "눌린 상태·sunken 면·인풋 안쪽" },
    "brand": { "$value": [{ "color": "#2081C33D", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" }], "$description": "primary CTA hover 글로우. 랜딩에서만" }
  },

  "shadow-dark": {
    "$type": "shadow",
    "$description": "다크 모드 그림자. 배경이 어두워 alpha 를 올리고, 대신 면 밝기 차이(surface.raised)가 고도의 주 신호가 된다.",
    "xs": { "$value": [{ "color": "#00000033", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "sm": { "$value": [{ "color": "#0000004D", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }] },
    "md": { "$value": [{ "color": "#00000066", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px" }] },
    "lg": { "$value": [{ "color": "#00000080", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-4px" }] },
    "xl": { "$value": [{ "color": "#00000099", "offsetX": "0px", "offsetY": "24px", "blur": "56px", "spread": "-8px" }] },
    "inner": { "$value": [{ "color": "#00000066", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "inset": true }] },
    "brand": { "$value": [{ "color": "#63D2FF40", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px" }] }
  },

  "gradient": {
    "$type": "gradient",
    "$description": "그라데이션은 '브랜드 표현' 자리에서만 쓴다: 히어로 배경, 프로모션 카드, 아바타 폴백, 로고 배경, 강조 텍스트. 버튼·인풋·표 같은 기능 UI 에는 쓰지 않는다. 각도는 135deg 하나로 고정해 화면 여러 곳에 나와도 한 시스템으로 읽히게 한다.",
    "brand": {
      "$value": [
        { "color": "{brand.twilight}", "position": 0 },
        { "color": "{brand.steel}",    "position": 0.55 },
        { "color": "{brand.ice}",      "position": 1 }
      ],
      "$description": "주 그라데이션. 히어로·OG 이미지·로그인 사이드 패널. 위 글자는 white. GitHub 프로필 헤더(1a2980→26d0ce)와 같은 계열"
    },
    "aurora": {
      "$value": [
        { "color": "{brand.steel}", "position": 0 },
        { "color": "{brand.aqua}",  "position": 1 }
      ],
      "$description": "밝은 보조 그라데이션. 배지·아바타 폴백·강조 텍스트(background-clip: text). 위 글자는 neutral.950"
    },
    "frost": {
      "$value": [
        { "color": "{brand.snow}", "position": 0 },
        { "color": "{blue.50}",    "position": 1 }
      ],
      "$description": "거의 안 보이는 배경 그라데이션. 랜딩 섹션 배경·빈 상태 카드. 위 글자는 text.primary 그대로"
    },
    "twilight": {
      "$value": [
        { "color": "{indigo.950}", "position": 0 },
        { "color": "{brand.twilight}", "position": 1 }
      ],
      "$description": "어두운 브랜드 면. 다크 히어로·푸터. 위 글자는 white / cyan.300"
    },
    "scrim-bottom": {
      "$value": [
        { "color": "#1B202700", "position": 0 },
        { "color": "#1B2027B3", "position": 1 }
      ],
      "$description": "이미지 위 글자 가독용 하단 스크림. 각도 180deg 예외"
    }
  },

  "gradient-angle": {
    "$type": "number",
    "default": { "$value": 135, "$description": "deg. brand·aurora·frost·twilight 공통" },
    "scrim":   { "$value": 180 }
  },

  "opacity": {
    "$type": "number",
    "disabled":     { "$value": 0.4,  "$description": "비활성 요소 전체에 거는 값. 색을 따로 바꾸지 않고 이것만 걸어도 된다" },
    "hover":        { "$value": 0.06, "$description": "interactive.hover-overlay 의 alpha 와 같다" },
    "pressed":      { "$value": 0.1 },
    "scrim":        { "$value": 0.5 },
    "skeleton":     { "$value": 0.6,  "$description": "스켈레톤 펄스 최저점" },
    "placeholder-image": { "$value": 0.08, "$description": "이미지 로딩 전 브랜드색 깔기" }
  },

  "blur": {
    "$type": "dimension",
    "sm": { "$value": "4px",  "$description": "스크림 뒤 미세 블러" },
    "md": { "$value": "12px", "$description": "글래스 헤더(backdrop-filter)" },
    "lg": { "$value": "24px", "$description": "모달 뒤 배경" }
  },

  "z-index": {
    "$type": "number",
    "$description": "레이어 순서. 컴포넌트 안에서 임의 z-index(999 등)를 쓰지 않는다. 같은 층 안 순서는 DOM 순서로 해결한다.",
    "hide":     { "$value": -1 },
    "base":     { "$value": 0 },
    "raised":   { "$value": 10,   "$description": "카드 hover·드래그 중 아이템" },
    "dropdown": { "$value": 1000, "$description": "셀렉트·메뉴·자동완성" },
    "sticky":   { "$value": 1100, "$description": "스티키 헤더·표 헤더" },
    "overlay":  { "$value": 1200, "$description": "스크림" },
    "modal":    { "$value": 1300 },
    "popover":  { "$value": 1400, "$description": "모달 안에서 열리는 팝오버·날짜 선택" },
    "toast":    { "$value": 1500 },
    "tooltip":  { "$value": 1600 }
  }
}
