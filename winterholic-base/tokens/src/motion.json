{
  "motion": {
    "$description": "모션은 상태 변화를 설명하기 위해서만 쓴다. 장식 애니메이션은 랜딩에 한정. prefers-reduced-motion 이면 duration 을 0 에 가깝게 내린다.",
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms",   "$description": "reduced-motion 대체값" },
      "fast":    { "$value": "100ms", "$description": "hover 색 변화·토글·체크박스" },
      "normal":  { "$value": "200ms", "$description": "드롭다운·툴팁·탭 인디케이터·아코디언(작은 높이). 기본" },
      "slow":    { "$value": "300ms", "$description": "모달·드로어·바텀시트 진입, 페이지 전환" },
      "slower":  { "$value": "500ms", "$description": "스켈레톤 펄스 한 주기·토스트 진입·랜딩 리빌" },
      "skeleton-cycle": { "$value": "1500ms", "$description": "스켈레톤 shimmer 한 바퀴" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1],    "$description": "화면 안에서 움직이는 것 전부. 기본" },
      "decelerate": { "$value": [0, 0, 0, 1],      "$description": "들어오는 것(모달·드로어·토스트 진입)" },
      "accelerate": { "$value": [0.3, 0, 1, 1],    "$description": "나가는 것(닫힘·사라짐). 진입보다 짧게" },
      "spring":     { "$value": [0.34, 1.56, 0.64, 1], "$description": "토글 손잡이·체크 표시·좋아요 같은 미세 피드백. 큰 면에는 쓰지 않는다" },
      "linear":     { "$value": [0, 0, 1, 1],      "$description": "프로그레스·스피너·shimmer 처럼 끝없이 도는 것" }
    },
    "distance": {
      "$type": "dimension",
      "$description": "진입 애니메이션 이동 거리",
      "sm": { "$value": "4px",  "$description": "툴팁·드롭다운 fade+slide" },
      "md": { "$value": "8px",  "$description": "토스트·팝오버" },
      "lg": { "$value": "16px", "$description": "모달·페이지 전환·랜딩 리빌" }
    },
    "scale": {
      "$type": "number",
      "enter": { "$value": 0.96, "$description": "모달·팝오버 진입 시작 크기" },
      "press": { "$value": 0.98, "$description": "버튼 active 눌림" }
    }
  }
}
