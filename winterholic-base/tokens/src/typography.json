{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Pretendard Variable", "Pretendard", "-apple-system", "BlinkMacSystemFont", "system-ui", "Roboto", "Helvetica Neue", "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", "sans-serif"],
        "$description": "한글·라틴 본문 전부. Pretendard 는 한글과 라틴의 굵기·x-height 가 맞아 한 서체로 끝난다. CDN: https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      },
      "mono": {
        "$value": ["JetBrains Mono", "D2Coding", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"],
        "$description": "코드·숫자 정렬(표의 금액·ID). D2Coding 은 한글 주석이 섞인 코드용 폴백"
      },
      "display": {
        "$value": ["Pretendard Variable", "Pretendard", "system-ui", "sans-serif"],
        "$description": "제목도 같은 서체를 쓴다. 서체를 바꾸는 대신 굵기·자간·크기로 위계를 만든다"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "$description": "4단계만 쓴다. 300 이하는 한글 가독성이 떨어져 금지, 800 이상은 Pretendard 에서 너무 무겁다.",
      "regular":  { "$value": 400, "$description": "본문" },
      "medium":   { "$value": 500, "$description": "라벨·버튼·표 헤더·강조 본문" },
      "semibold": { "$value": 600, "$description": "제목(h3~h6)·카드 타이틀·탭 활성" },
      "bold":     { "$value": 700, "$description": "큰 제목(display·h1·h2)·숫자 강조" }
    },
    "size": {
      "$type": "dimension",
      "$description": "1rem = 16px. 11px 아래로는 내려가지 않는다(2xs 가 하한).",
      "2xs": { "$value": "0.6875rem", "$description": "11px · 배지 안 글자·법적 고지. 최소" },
      "xs":  { "$value": "0.75rem",   "$description": "12px · 캡션·타임스탬프·표 보조" },
      "sm":  { "$value": "0.875rem",  "$description": "14px · 보조 본문·폼 라벨·표 본문·sm 버튼" },
      "md":  { "$value": "1rem",      "$description": "16px · 본문 기본·md 버튼·인풋" },
      "lg":  { "$value": "1.125rem",  "$description": "18px · 강조 본문·lg 버튼·h5" },
      "xl":  { "$value": "1.25rem",   "$description": "20px · h4·카드 타이틀" },
      "2xl": { "$value": "1.5rem",    "$description": "24px · h3·모달 제목" },
      "3xl": { "$value": "1.875rem",  "$description": "30px · h2·페이지 제목" },
      "4xl": { "$value": "2.25rem",   "$description": "36px · h1(앱)" },
      "5xl": { "$value": "3rem",      "$description": "48px · display-md(랜딩 제목)" },
      "6xl": { "$value": "3.75rem",   "$description": "60px · display-lg(히어로)" }
    },
    "line-height": {
      "$type": "number",
      "$description": "단위 없는 배수. 한글은 라틴보다 행간을 넉넉히 잡아야 한다 — 본문 1.6 이 기준.",
      "none":    { "$value": 1,    "$description": "아이콘과 나란한 한 줄 라벨·숫자 타일" },
      "tight":   { "$value": 1.2,  "$description": "display·h1" },
      "snug":    { "$value": 1.3,  "$description": "h2~h4" },
      "normal":  { "$value": 1.5,  "$description": "라벨·버튼·짧은 UI 텍스트" },
      "relaxed": { "$value": 1.6,  "$description": "본문 기본(한글)" },
      "loose":   { "$value": 1.75, "$description": "긴 글(prose)·소개 문단" }
    },
    "letter-spacing": {
      "$type": "dimension",
      "$description": "Pretendard 는 기본 자간이 넓은 편이라 큰 글자는 조인다. 본문은 0 에 가깝게.",
      "tighter": { "$value": "-0.03em", "$description": "display" },
      "tight":   { "$value": "-0.02em", "$description": "h1~h3" },
      "snug":    { "$value": "-0.01em", "$description": "h4~h6·본문 lg" },
      "normal":  { "$value": "0em",     "$description": "본문·라벨" },
      "wide":    { "$value": "0.04em",  "$description": "overline·전부 대문자 라틴 라벨" }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "역할별 완성 스타일. 화면에는 이 이름으로만 글자를 놓는다(개별 size·weight 조합 금지). 각 값은 font.* 토큰을 참조한다.",

    "display-lg": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.6xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.tighter}" }, "$description": "랜딩 히어로 한 줄. 모바일에서는 display-md 로 내린다" },
    "display-md": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.5xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.tighter}" }, "$description": "랜딩 섹션 제목" },
    "display-sm": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.4xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.tight}" }, "$description": "랜딩 모바일 히어로·큼직한 숫자 KPI" },

    "heading-1": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.3xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.tight}" }, "$description": "앱 페이지 제목. 페이지당 1개" },
    "heading-2": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.2xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.tight}" }, "$description": "섹션 제목·모달 제목" },
    "heading-3": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.snug}" }, "$description": "카드 제목·서브섹션" },
    "heading-4": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.snug}" }, "$description": "리스트 그룹 제목·사이드바 섹션" },
    "heading-5": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "작은 카드 제목·폼 섹션 제목" },
    "heading-6": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "표 컬럼 그룹·아주 작은 구획 제목" },

    "body-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.letter-spacing.snug}" }, "$description": "랜딩 리드 문단·소개 글" },
    "body-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "본문 기본. 모르면 이것" },
    "body-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "보조 설명·표 본문·카드 설명" },
    "body-xs": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "메타 정보 여러 줄" },

    "label-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "lg 버튼·탭·내비 항목" },
    "label-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "md 버튼·폼 라벨·표 헤더·메뉴 항목. 기본" },
    "label-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "sm·xs 버튼·배지·칩" },

    "caption":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "도움말·타임스탬프·글자수 카운터. text.tertiary 와 짝" },
    "overline": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.2xs}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.wide}" }, "$description": "섹션 위 작은 카테고리 라벨(대문자·자간 넓게)" },
    "code":     { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "코드 블록·인라인 코드(인라인은 0.9em 으로 본문에 맞춘다)" },
    "numeric":  { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.none}", "letterSpacing": "{font.letter-spacing.normal}" }, "$description": "표 금액·수치. font-variant-numeric: tabular-nums 를 함께 건다" }
  }
}
