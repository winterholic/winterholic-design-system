      "radius": { "$value": "{radius.sm}", "$type": "dimension" },
      "text-height": { "$value": "0.75em", "$type": "dimension" }
    },

    "empty": {
      "$description": "빈 셀도 일러스트 자리로 채운다(회색 빈칸 금지). 빈 상태 = 캡슐 sm + 카피",
      "capsule-size": { "$value": "{size.capsule.sm}", "$type": "dimension" },
      "title-typography": { "$value": "{typography.heading-sm}", "$type": "typography" },
      "body-typography": { "$value": "{typography.body}", "$type": "typography" },
      "padding-y": { "$value": "{space.9}", "$type": "dimension" }
    }
  }
}
